# ==============================================================================
# CIC Landing Platform (cic-ldp) - Cấu hình biến môi trường mẫu (.env.example)
# Lưu ý: Tệp `.env` này là TÙY CHỌN. Mã nguồn (@cic/db & seed/auto-seed.mjs)
# đã tích hợp sẵn kết nối mặc định tới Supabase Self-Host tại cổng 54322.
# Chỉ cần tạo `.env` nếu bạn muốn đổi cổng DB hoặc cấu hình SMTP/Google Sheets.
# ==============================================================================

# 1. Kết nối PostgreSQL / Supabase Self-Host (Mặc định sẵn trong code)
DATABASE_URL="postgresql://postgres:cic_supabase_2026@127.0.0.1:54322/postgres"

# 2. Khóa bí mật ký phiên đăng nhập Quản trị viên Web CMS
AUTH_SECRET="cic-landing-platform-supabase-auth-secret-2026"

# 3. Chế độ chạy:
# - Để trống (mặc định): Chạy Master Hub quản lý tập trung cả 14 trang Landing Page
# - Điền mã trang (VD: DEFAULT_SITE_CODE="robot-cong-trinh"): Chạy độc lập 1 trang duy nhất
DEFAULT_SITE_CODE=""

# 4. Cấu hình gửi Email thông báo Lead (Tùy chọn - SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CIC Platform <no-reply@cic.com.vn>"
LEAD_NOTIFY_EMAIL="info@cic.com.vn"

# 5. Đồng bộ Google Sheets & Bitrix24 CRM Webhook (Tùy chọn)
GOOGLE_CREDENTIALS_DIR="./credentials"
BITRIX24_WEBHOOK_URL=""
