{
  "name": "bim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @cic/landing-hub run dev",
    "build": "npm --workspace @cic/landing-hub run build",
    "start": "npm --workspace @cic/landing-hub run start",
    "db:seed": "node seed/auto-seed.mjs",
    "setup": "npm install && node seed/auto-seed.mjs && npm --workspace @cic/landing-hub run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "dotenv": "^17.2.3",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.546.0",
    "next": "^16.2.1",
    "nodemailer": "^7.0.11",
    "postgres": "^3.4.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
